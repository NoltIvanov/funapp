<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MauiApp1.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MauiApp1.Views"
       Title="MauiApp1"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginView}"
                  Route="Login"
                  Shell.TabBarIsVisible="False" />

    <ShellContent Title="Main"
                  ContentTemplate="{DataTemplate views:MainTabbedPage}"
                  Route="Main"
                  Shell.TabBarIsVisible="True" />

</Shell>
